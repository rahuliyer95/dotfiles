# vim:fileencoding=utf-8:ft=conf:foldmethod=marker
# https://github.com/mitchellh/ghostty/blob/main/src/config/Config.zig

# Font {{{

adjust-cell-height = 25%
font-size          = 18
font-family        = Google Sans Code

# }}}

# Theme {{{

theme = TokyoNight Storm

# }}}

# Cursor {{{

cursor-style       = block
cursor-style-blink = true

# }}}

# Mouse {{{

focus-follows-mouse = true

# }}}

# macOS {{{

macos-option-as-alt           = true
macos-secure-input-indication = false
macos-titlebar-style          = tabs

# }}}

# Window {{{

background-opacity = 0.95
window-height      = 28
window-width       = 118
window-colorspace  = display-p3

# }}}

# Shell Integration {{{

shell-integration          = zsh
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# }}}

# Miscellaneous {{{

auto-update             = download
keybind                 = shift+enter=text:\n
keybind                 = super+v=paste_from_clipboard
keybind                 = super+alt+h=goto_split:left
keybind                 = super+alt+j=goto_split:down
keybind                 = super+alt+k=goto_split:up
keybind                 = super+alt+l=goto_split:right
# 4 GB
scrollback-limit        = 4_294_967_295
unfocused-split-opacity = 0.7

# }}}
